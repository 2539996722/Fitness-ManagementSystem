# ============================================
# FitHub Backend Environment Variables Template
# ============================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env   (or on Windows: copy .env.example .env)
# .env must NOT be committed to Git!

# ---------- Application ----------
APP_NAME=FitHub API
APP_ENV=development                       # development | staging | production
DEBUG=true                                # MUST be false in production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR
TZ=Asia/Shanghai

# ---------- Database (MySQL) ----------
# Option 1: Full DSN (recommended)
# IMPORTANT: special characters in password MUST be URL-encoded:
#   @ → %40   # → %23   $ → %24   % → %25   & → %26   ? → %3F
# Example password "Lb@403706" becomes "Lb%40403706" in the DSN.
# IMPORTANT: replace `<YOUR_MYSQL_PASSWORD>` with your actual password.
MYSQL_DSN=mysql+aiomysql://root:<YOUR_MYSQL_PASSWORD>@localhost:3306/fithub?charset=utf8mb4

# Option 2: Split fields (uncomment and fill if not using MYSQL_DSN)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=fithub_user
# MYSQL_PASSWORD=fithub_pass
# MYSQL_DB=fithub

# ---------- docker-compose 专用（仅启动 MySQL 容器用，backend 不直接读）----------
# 本地用 Docker 起 MySQL 时配这里；不走 docker-compose 的可以忽略
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_USER=fithub_user
MYSQL_PASSWORD=fithub_pass
MYSQL_DB=fithub
MYSQL_PORT=3306

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false                             # Set true to log all SQL (dev only)

# ---------- JWT Auth ----------
# JWT_SECRET must be >= 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120           # 2 hours
REFRESH_TOKEN_EXPIRE_DAYS=7               # 7 days

# Default admin (auto-created only when users table is empty)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-immediately   # ! MUST change after first login

# ---------- CORS ----------
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080
CORS_ALLOW_CREDENTIALS=true

# ---------- LLM (OpenAI-compatible protocol) ----------
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-openai-api-key-here
LLM_MODEL_CHAT=gpt-4o-mini                # Chat completions (4 scenarios)
LLM_MODEL_EMBED=text-embedding-3-small    # Embeddings for RAG
LLM_TIMEOUT=60                            # Single request timeout (seconds)
LLM_MAX_RETRIES=2

# Alternative providers (OpenAI-compatible):
# DeepSeek:
#   LLM_API_BASE=https://api.deepseek.com/v1
#   LLM_API_KEY=sk-your-deepseek-key
#   LLM_MODEL_CHAT=deepseek-chat
#
# Alibaba Qwen:
#   LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_API_KEY=sk-your-qwen-key
#   LLM_MODEL_CHAT=qwen-plus

# ---------- Vector DB (Milvus Lite - embedded) ----------
# Storage for child-chunk embeddings (PRD §6.3).
# Embedded mode: writes to local file, no separate server required.
MILVUS_URI=./data/milvus_lite.db            # Local file path for embedded mode
# For standalone Milvus server, use:
# MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=exercises_chunks
MILVUS_EMBED_DIM=1536                      # Must match LLM_MODEL_EMBED output dim
MILVUS_TOP_K=5                             # Default Top-K for retrieval

# ---------- Cache (Redis - short-term conversation buffer) ----------
# Stores last N rounds of conversation context per user (PRD §7).
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=                           # Leave blank if no password
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20
REDIS_SESSION_CACHE_ROUNDS=5              # Recent N rounds per user
REDIS_SESSION_TTL_SECONDS=3600            # Auto-expire after 1 hour of inactivity

# ---------- File Upload ----------
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=./data/uploads

# ---------- Static Assets (exercise media) ----------
EXERCISES_IMAGE_BASE_URL=/static/images
EXERCISES_GIF_BASE_URL=/static/videos
EXERCISES_DATA_DIR=E:/my_Program/健身管理/data/exercises-dataset-zh-master
# ---------- Email (reserved) ----------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=noreply@fithub.com
# SMTP_PASSWORD=smtp-password
# SMTP_FROM=noreply@fithub.com
# SMTP_USE_SSL=true

# ---------- SMS (reserved) ----------
# SMS_PROVIDER=aliyun
# SMS_ACCESS_KEY=your-access-key
# SMS_ACCESS_SECRET=your-access-secret
# SMS_SIGN_NAME=FitHub
# SMS_TEMPLATE_CODE=SMS_123456

# ---------- Third-party Login (reserved) ----------
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_REDIRECT_URI=

# ---------- Monitoring (optional) ----------
# SENTRY_DSN=https://xxx@sentry.io/xxx
# PROMETHEUS_ENABLED=false

# ---------- Security ----------
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=false               # Set true in production (requires HTTPS)
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax